.form-page { padding: 30rpx 32rpx 70rpx; }
.form-title { display: block; font-size: 42rpx; font-weight: 650; }
.form-description { display: block; margin-top: 14rpx; color: #8b9186; font-size: 24rpx; }
.form-label { display: block; margin: 28rpx 0 12rpx; font-size: 25rpx; font-weight: 600; }
.field { display: block; width: 100%; min-height: 78rpx; padding: 22rpx; border-radius: 14rpx; background: #fffefa; font-size: 26rpx; }
.field-placeholder { color: #a1a299; }
.choice-menu { overflow: hidden; margin-top: 6rpx; border: 1rpx solid #eeede6; border-radius: 14rpx; background: #fffefa; }
.choice-empty { display: block; padding: 20rpx 22rpx; color: #969b91; font-size: 24rpx; }
.route-status { padding: 16rpx 22rpx; color: #8b9186; font-size: 24rpx; }
.note { height: 180rpx; }
.save { margin-top: 34rpx; padding: 20rpx; border-radius: 16rpx; background: #3f5d4e; color: white; text-align: center; }
.route-option { display: block; width: 100%; height: 72rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #efeee7; background: #fffefa; color: #496454; text-align: left; font-size: 24rpx; line-height: 36rpx; }
