<view class="detail-shell">
  <view wx:if="{{guide}}" class="detail-header"><text class="eyebrow">CLIMBING GUIDEBOOK</text><text class="detail-title">{{guide.title}}</text><text class="detail-location">{{guide.location}}</text><text class="detail-description">{{guide.description}}</text></view>
  <scroll-view wx:if="{{guide}}" class="section-scroll" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="section-{{section.id}}"><view class="section-tabs"><button wx:for="{{guide.sections}}" wx:key="id" id="section-{{item.id}}" class="section-tab {{section.id === item.id ? 'section-tab--active' : ''}}" data-id="{{item.id}}" bindtap="selectSection"><text>{{item.title}}</text><text class="section-tab-count">{{item.endPage - item.startPage + 1 + (item.intro && item.id !== 'intro' ? 1 : 0)}} 页</text></button></view></scroll-view>
  <view wx:if="{{section.intro && page === pageBase}}" class="section-intro"><text class="section-intro-title">{{section.title}}</text><view wx:for="{{section.intro}}" wx:key="label" class="intro-block"><text class="intro-label">{{item.label}}</text><text class="intro-text">{{item.text}}</text></view><text wx:if="{{section.id !== 'intro'}}" class="intro-routes">下一页查看线路图与线路说明</text></view>
  <view wx:if="{{section}}" class="page-controls"><button class="page-button" disabled="{{loading || page <= pageBase}}" bindtap="previousPage">上一页</button><picker mode="selector" range="{{pageOptions}}" value="{{page - pageBase}}" disabled="{{loading}}" bindchange="selectPage"><text class="page-count">{{page - pageBase + 1}} / {{section.endPage - pageBase + 1}} ⌄</text></picker><button class="page-button" disabled="{{loading || page >= section.endPage}}" bindtap="nextPage">下一页</button></view>
  <view wx:if="{{loading}}" class="page-status">正在加载路书…</view>
  <view wx:elif="{{error}}" class="page-status"><text>{{error}}</text><button class="quiet-button" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{image}}" class="page-image-wrap"><image class="page-image" src="{{image}}" mode="widthFix" bindtap="preview" /><text class="page-hint">点击图片可放大查看</text></view>
  <view wx:if="{{section && image && !loading && !error}}" class="page-controls bottom-controls"><button class="page-button" disabled="{{page <= pageBase}}" bindtap="previousPage">上一页</button><text class="page-count">{{page - pageBase + 1}} / {{section.endPage - pageBase + 1}}</text><button class="page-button" disabled="{{page >= section.endPage}}" bindtap="nextPage">下一页</button></view>
</view>
