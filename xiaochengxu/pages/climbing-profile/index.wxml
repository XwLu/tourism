<view class="page-shell">
  <text class="eyebrow">MY CLIMBING JOURNAL</text><text class="profile-title">我的攀爬日记</text>
  <view wx:if="{{loading || error}}" class="trip-status"><text>{{loading ? '正在读取记录…' : error}}</text><button wx:if="{{error}}" bindtap="load">重试</button></view>
  <view wx:if="{{profile}}" class="profile-name"><image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" />{{profile.nickName}}</view>
  <view wx:elif="{{!loading && !error}}" class="profile-setup"><text>选择微信头像并填写昵称，开始记录。</text><button open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" /><text wx:else>选择头像</text></button><input type="nickname" placeholder="填写昵称" value="{{nickName}}" bindinput="inputName" /><button bindtap="saveProfile" loading="{{saving}}">保存资料</button></view>
  <view class="section-heading"><text class="section-title">数据统计</text></view>
  <view class="stats"><view><text>{{activityCount}}</text><text>参加活动</text></view><view><text>{{topropeCount}}</text><text>顶绳次数</text></view><view><text>{{leadCount}}</text><text>先锋次数</text></view><view><text>{{redpointCount}}</text><text>红点路线</text></view></view>
  <view class="section-heading"><text class="section-title">攀爬次数趋势</text><text class="section-caption">每 7 天累计</text></view>
  <view class="chart-card"><view class="chart-legend"><text class="legend-total">● 合计</text><text class="legend-lead">● 先锋</text><text class="legend-toprope">● 顶绳</text></view><canvas id="climbing-chart" type="2d" class="chart" /><text class="chart-caption">{{chartWeeks.length ? '从首条记录开始 · 按保存日期统计' : '暂无攀爬记录'}}</text></view>
  <view class="section-heading"><text class="section-title">路线回顾</text></view>
  <view wx:if="{{!loading && !error && !records.length}}" class="climbing-empty">暂时还没有攀爬记录哦～</view>
  <button class="review-button" bindtap="openReview">查询路线记录 ›</button>
</view>
