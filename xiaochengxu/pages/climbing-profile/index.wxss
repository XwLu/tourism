.profile-title { display: block; margin-top: 24rpx; font-size: 44rpx; font-weight: 650; }
.profile-name { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; color: #647668; }
.profile-name image, .profile-setup image { width: 64rpx; height: 64rpx; border-radius: 50%; }
.profile-setup { margin-top: 24rpx; padding: 24rpx; border-radius: 16rpx; background: white; font-size: 24rpx; }
.profile-setup button, .profile-setup input { margin-top: 18rpx; padding: 14rpx; border-radius: 12rpx; background: #e9efe7; }
.stats { display: flex; flex-wrap: wrap; gap: 12rpx; }
.stats view { width: calc(50% - 6rpx); padding: 24rpx; border-radius: 18rpx; background: #fffefa; }
.stats text { display: block; color: #8a9386; font-size: 23rpx; }
.stats text:first-child { margin-bottom: 8rpx; color: #3f5d4e; font-size: 42rpx; font-weight: 650; }
.chart-card { padding: 24rpx 18rpx; border-radius: 18rpx; background: #fffefa; }
.chart-legend { display: flex; justify-content: center; gap: 28rpx; font-size: 22rpx; }
.legend-total { color: #111111; }.legend-lead { color: #dc5149; }.legend-toprope { color: #3c80c8; }
.chart { display: block; width: 100%; height: 320rpx; margin-top: 12rpx; }
.chart-caption { display: block; color: #92988d; font-size: 20rpx; text-align: center; }
.climbing-empty { padding: 38rpx 24rpx; border-radius: 16rpx; background: #fffefa; color: #8a9386; font-size: 25rpx; text-align: center; }
.review-button { margin-top: 18rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: #e9efe7; color: #496454; text-align: center; font-size: 25rpx; }
