view,
button {
  box-sizing: border-box;
}

:host {
  display: block;
  margin-bottom: 18rpx;
}
.travel-card {
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 5rpx 20rpx rgba(48, 49, 35, 0.035);
}
.travel-card--pressed {
  opacity: 0.85;
}
.card-cover {
  position: relative;
  overflow: hidden;
  background: #bdcbc0;
  color: #fffdf3;
}
.cover-image,
.cover-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}
.cover-shade {
  background: linear-gradient(180deg, rgba(22, 44, 43, 0.12), transparent 38%, rgba(18, 39, 35, 0.52));
}
.day-badge {
  position: absolute;
  top: 20rpx;
  left: 18rpx;
  padding: 7rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 7rpx;
  background: rgba(255, 255, 255, 0.12);
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.cover-date {
  position: absolute;
  top: 25rpx;
  right: 18rpx;
  font-size: 21rpx;
  font-weight: 500;
}
.cover-words {
  position: absolute;
  right: 18rpx;
  bottom: 66rpx;
  left: 22rpx;
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.4;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.12);
}
.cover-words text {
  display: block;
}
.cover-city {
  position: absolute;
  bottom: 26rpx;
  left: 24rpx;
  font-size: 19rpx;
  letter-spacing: 3rpx;
}
.card-body {
  padding: 22rpx 20rpx 10rpx;
}
.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
  color: #8b8171;
  font-size: 19rpx;
  line-height: 1.7;
}
.card-tags text {
  margin-right: 12rpx;
}
.card-title {
  display: block;
  color: #2b342e;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
}
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.card-author {
  display: flex;
  align-items: center;
  color: #9a9b93;
  font-size: 19rpx;
}
.author-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #bfcec0;
}
.save-button {
  display: flex;
  width: 68rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0 -12rpx 0 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #a4a59e;
  font-size: 39rpx;
  line-height: 1;
}
.save-button::after {
  border: 0;
}
.is-saved {
  color: #df5149;
}
