view,
button {
  box-sizing: border-box;
}

:host {
  display: block;
  margin-bottom: 18rpx;
}
.travel-card {
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 5rpx 20rpx rgba(48, 49, 35, 0.035);
}
.travel-card--pressed {
  opacity: 0.85;
}
.card-cover {
  position: relative;
  overflow: hidden;
  background: #bdcbc0;
}
.cover-image {
  position: absolute;
  width: 100%;
  height: 100%;
}
.card-body {
  padding: 22rpx 20rpx 10rpx;
}
.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
  color: #8b8171;
  font-size: 19rpx;
  line-height: 1.7;
}
.card-tags text {
  margin-right: 12rpx;
}
.card-title {
  display: block;
  color: #2b342e;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
}
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.card-author {
  display: flex;
  align-items: center;
  color: #9a9b93;
  font-size: 19rpx;
}
.author-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #bfcec0;
}
.save-button {
  display: flex;
  width: 68rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0 -12rpx 0 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #a4a59e;
  font-size: 39rpx;
  line-height: 1;
}
.save-button::after {
  border: 0;
}
.is-saved {
  color: #df5149;
}
